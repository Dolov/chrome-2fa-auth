# E2E 测试凭证（真实 GitHub / NPM test 账号）
# 复制本文件为 .env.e2e 并填写真实值
# .env.e2e 已在 .gitignore，不会被 commit

# ===== GitHub test 账号 =====
# 建议：在 GitHub 注册专用 test 账号，2FA 用 authenticator app（不用 SMS）
# 注册步骤：
#   1. https://github.com/signup 注册新账号
#   2. Settings → Password and authentication → Enable 2FA
#   3. 选择 "Authenticator app"，扫描 QR 后保存显示的 secret
#   4. 保存 recovery codes 到 1Password

E2E_GITHUB_USER=
E2E_GITHUB_PASSWORD=
E2E_GITHUB_TOTP_SECRET=        # base32，扫码时显示的 secret（如 JBSWY3DPEHPK3PXP）

# ===== NPM test 账号 =====
# NPM 2FA 也需要 authenticator app + 保存 secret

E2E_NPM_USER=
E2E_NPM_PASSWORD=
E2E_NPM_TOTP_SECRET=

# ===== 可选：CI 用（GitHub Actions secrets 注入）=====
# 在 CI 里通过 secrets.E2E_GITHUB_PASSWORD 等环境变量注入，.env.e2e 不上传